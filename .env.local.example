# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API-Football (https://www.api-football.com/) — Pro plan, covers the Swiss
# Super League with per-fixture player statistics. Find the league's numeric
# id via GET /leagues?search=Switzerland (see README) and put it here too.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_LEAGUE_ID=

# Random secret; sent as a Bearer token by the Vercel Cron job so nobody else
# can trigger /api/cron/sync. Generate with: openssl rand -base64 32
CRON_SECRET=
