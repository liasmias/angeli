# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API-Football (https://www.api-football.com/) — Pro plan, covers the Swiss
# Super League with per-fixture player statistics. Find the league's numeric
# id via GET /leagues?search=Switzerland (see README) and put it here too.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_LEAGUE_ID=

# Random secret; sent as a Bearer token by the Vercel Cron job so nobody else
# can trigger /api/cron/sync. Generate with: openssl rand -base64 32
CRON_SECRET=

# Öffentliche Adresse der App. Wird für die Links in Passwort-zurücksetzen-
# Mails gebraucht. Muss exakt so auch in Supabase unter
# Authentication → URL Configuration → Redirect URLs eingetragen sein
# (dort mit dem Pfad /auth/callback).
NEXT_PUBLIC_SITE_URL=https://angeli-fantasy.org

# Cloudflare Turnstile (Bot-Schutz für Registrierung/Login). Optional:
# Ist der Site-Key leer, ist der Schutz inaktiv und die Formulare laufen normal.
# Zum Aktivieren: den PUBLIC Site-Key hier setzen UND in Supabase
# (Auth → Bot & Abuse Protection) CAPTCHA mit dem SECRET-Key einschalten.
# Der Secret-Key gehört NUR ins Supabase-Dashboard, nie in diese Datei.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
